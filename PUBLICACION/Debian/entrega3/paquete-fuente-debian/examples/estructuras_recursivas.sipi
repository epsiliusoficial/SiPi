programa "Estructuras de datos correctamente aisladas por llamada (scoping real)"

funcion construir_lista_hasta(n)
    si n <= 0
        lista_crear vacia
        devolver vacia
    fin
    variable n_menos_uno = n - 1
    llamar_valor construir_lista_hasta(n_menos_uno) -> lista_previa
    lista_agregar lista_previa n
    devolver lista_previa
fin

llamar_valor construir_lista_hasta(5) -> numeros
decir "Lista construida con recursion: {numeros}"

funcion crear_nodo_arbol(valor, profundidad)
    diccionario_crear nodo
    diccionario_asignar nodo "valor" valor
    si profundidad > 0
        variable profundidad_menor = profundidad - 1
        llamar_valor crear_nodo_arbol(valor * 2, profundidad_menor) -> hijo
        diccionario_obtener hijo "valor" -> valor_hijo
        diccionario_asignar nodo "hijo_valor" valor_hijo
    fin
    devolver nodo
fin

llamar_valor crear_nodo_arbol(1, 3) -> arbol
diccionario_obtener arbol "valor" -> valor_raiz
diccionario_obtener arbol "hijo_valor" -> valor_del_hijo
decir "Valor de la raiz del arbol: {valor_raiz}"
decir "Valor del hijo directo: {valor_del_hijo}"

decir ""
decir "Cada llamada a una funcion tiene su propio espacio de variables,"
decir "aislado del resto, tal como en cualquier lenguaje de programacion serio."
