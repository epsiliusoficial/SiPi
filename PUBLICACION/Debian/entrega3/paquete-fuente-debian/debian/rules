#!/usr/bin/make -f
# SiPi es una coleccion de scripts de Python puro: no hay nada que
# compilar. dh_auto_build/dh_auto_test detectan que no hay un sistema
# de build conocido (sin setup.py/Makefile) y no hacen nada, que es
# exactamente lo que se necesita aca.
#
# Reproducibilidad: SOURCE_DATE_EPOCH se deriva automaticamente de la
# fecha de debian/changelog (dpkg-buildpackage lo hace solo si no esta
# ya seteado en el entorno), y debhelper compat 13 ya clampea mtimes y
# usa dpkg-deb --root-owner-group + compresion determinista por
# defecto -- no hace falta nada especial aca para lograrlo.

%:
	dh $@

override_dh_installexamples:
	# los ejemplos se instalan como parte de sipi-examples via su
	# archivo .install (recurso de datos, no "ejemplos de la doc"),
	# asi que no hay nada mas que hacer aca.
	dh_installexamples

override_dh_installchangelogs:
	# docs/CHANGELOG.md es el changelog de UPSTREAM (del lenguaje SiPi
	# en si, no de este empaquetado Debian) -- dh_installchangelogs lo
	# instala con el nombre canonico que espera la Politica de Debian
	# (usr/share/doc/sipi/changelog.gz), separado de
	# usr/share/doc/sipi/changelog.Debian.gz (que sale solo de
	# debian/changelog). Antes estaba tambien listado en
	# debian/sipi.docs, lo que lo instalaba DOS veces con nombres
	# distintos -- lintian lo marcaba con wrong-name-for-upstream-changelog.
	dh_installchangelogs docs/CHANGELOG.md

# 'dh_installdocs' instala tambien LICENSE si estuviera en cada
# .docs -- se omite deliberadamente de los .docs (queda solo en
# debian/copyright, que es el lugar canonico de Debian para la
# licencia) para no duplicar el mismo texto en dos archivos distintos
# que alguien podria editar y dejar inconsistentes entre si.
