programa "Automatizacion de escritorio real"

decir "Tomando una captura de pantalla real..."
captura_pantalla "captura_del_escritorio.png"

decir "Copiando texto al portapapeles del sistema..."
copiar_portapapeles "Este texto fue copiado por SiPi"

pegar_portapapeles -> texto_recuperado
decir "Texto recuperado del portapapeles: {texto_recuperado}"

decir ""
decir "Listo. Revisa captura_del_escritorio.png"
