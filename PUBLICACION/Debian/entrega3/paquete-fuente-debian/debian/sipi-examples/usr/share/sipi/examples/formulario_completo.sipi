programa "Formulario completo con todos los widgets"

funcion enviar_formulario()
    decir "Nombre ingresado: {campo_nombre}"
    decir "Le gusta programar: {acepta}"
    decir "Lenguaje elegido: {lenguaje_elegido}"
fin

ventana "SiPi - Formulario" 420 380
    etiqueta "Formulario de ejemplo" 110 15
    etiqueta "Tu nombre:" 30 60
    entrada campo_nombre 140 58
    casilla "Me gusta programar" 30 100 acepta
    etiqueta "Elegi un lenguaje:" 30 140
    lista 30 165 30 5 "Python|JavaScript|SiPi|C++|Java" -> lenguaje_elegido
    boton "Enviar" 150 320 enviar_formulario()
fin
