#!/bin/sh
set -eu
echo "== sipi-examples: hola_mundo.sipi instalado =="
test -f /usr/share/sipi/examples/hola_mundo.sipi

echo "== sipi-examples: hola_mundo.sipi corre sin error =="
sipi /usr/share/sipi/examples/hola_mundo.sipi

echo "== sipi-examples: al menos 20 ejemplos presentes =="
cantidad="$(find /usr/share/sipi/examples -name '*.sipi' | wc -l)"
if [ "$cantidad" -lt 20 ]; then
    echo "FALLO: se esperaban >= 20 ejemplos, hay $cantidad" >&2
    exit 1
fi

echo "OK: todos los checks de sipi-examples pasaron ($cantidad ejemplos)"
