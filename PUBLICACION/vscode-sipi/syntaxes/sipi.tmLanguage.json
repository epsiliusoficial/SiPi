{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SiPi",
  "scopeName": "source.sipi",
  "fileTypes": [
    "sipi"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#interpolation-braces"
    },
    {
      "include": "#pipe-operator"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sipi",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sipi",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sipi",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sipi",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.sipi",
          "match": "\\{[^}]*\\}"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.sipi",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "keywords": {
      "name": "keyword.control.sipi",
      "match": "\\b(si|sino|fin|mientras|repetir|para_cada|en|romper|continuar|funcion|devolver|intentar|capturar|lanzar_error|clase|metodo|hereda_de|nuevo|interfaz|implementa|este|veces|seleccionar|caso|otro)\\b"
    },
    "types": {
      "name": "storage.type.sipi",
      "match": "\\b(entero|decimal|numero|texto|booleano|lista|diccionario)\\b"
    },
    "constants": {
      "name": "constant.language.sipi",
      "match": "\\b(verdadero|falso|nulo|PI|E)\\b"
    },
    "commands": {
      "name": "support.function.sipi",
      "match": "\\b(fecha_diferencia_dias|instalar_dependencias|imagen_redimensionar|detener_temporizador|diccionario_eliminar|iniciar_servidor_web|generar_app_android|diccionario_obtener|diccionario_asignar|copiar_portapapeles|generar_app_windows|desinstalar_modulo|audio_generar_tono|diccionario_claves|generar_pagina_web|pegar_portapapeles|rotacion_velocidad|modo_principiante|diccionario_tiene|fecha_hora_actual|diccionario_crear|texto_termina_con|texto_empieza_con|comprimir_carpeta|captura_pantalla|descomprimir_zip|menu_desplegable|actualizar_barra|texto_reemplazar|imagen_convertir|sqlite_consultar|fecha_sumar_dias|registrar_evento|instalar_paquete|fecha_dia_semana|listar_archivos|sqlite_conectar|mostrar_puntaje|instalar_modulo|fecha_formatear|puntaje_inicial|reproducir_tono|sqlite_ejecutar|matriz_columnas|mover_aleatorio|detener_api_web|es_instancia_de|iniciar_api_web|texto_recortar|barra_progreso|lista_longitud|lista_invertir|lista_eliminar|listar_modulos|matriz_obtener|matriz_asignar|copiar_archivo|borrar_archivo|audio_duracion|texto_contiene|elegir_al_azar|responder_json|promedio_lista|lista_contiene|fecha_es_mayor|lista_aplanar|camara_seguir|lista_ordenar|lista_agregar|texto_dividir|crear_archivo|llamar_metodo|texto_repetir|escuchar_ruta|sqlite_cerrar|lista_filtrar|crear_carpeta|lista_reducir|lista_obtener|lanzar_error|obtener_dato|leer_archivo|matriz_filas|json_guardar|guardar_dato|llamar_valor|tamano_mundo|lista_mapear|matriz_crear|crear_juego|csv_guardar|obtener_url|borrar_dato|lista_crear|imagen_info|suma_lista|minusculas|json_texto|mayusculas|json_crear|hash_texto|formulario|particulas|modo_debug|pagina_web|estructura|azar_entre|lista_unir|instanciar|pestanias|separador|continuar|explosion|preguntar|redondear|subtitulo|velocidad|lista_web|patrullar|json_leer|hereda_de|escena_3d|para_cada|capturar|interfaz|gravedad|segundos|importar|ejecutar|mientras|potencia|imprimir|devolver|friccion|csv_leer|longitud|etiqueta|variable|programa|intentar|esperar|tarjeta|casilla|pestana|ventana|version|escapar|entrada|funcion|tipo_de|repetir|cuadro|maximo|seguir|restar|llamar|imagen|minimo|figura|metodo|titulo|enlace|rebote|sonido|chocar|romper|sprite|fuego|ayuda|decir|boton|nuevo|lista|color|const|sumar|texto|clase|campo|veces|cada|raiz|este|enum|humo|tono|sino|tema|fin|var|si|ia)\\b"
    },
    "interpolation-braces": {
      "name": "meta.interpolation.sipi",
      "match": "\\{[^}]*\\}"
    },
    "pipe-operator": {
      "name": "keyword.operator.pipe.sipi",
      "match": "\\|>"
    }
  }
}