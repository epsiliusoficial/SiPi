{
  "name": "sipi-lang",
  "displayName": "SiPi",
  "description": "Resaltado de sintaxis, snippets y configuracion de lenguaje para SiPi (lenguaje de programacion en español).",
  "version": "0.1.0",
  "publisher": "sipi-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages", "Snippets"],
  "contributes": {
    "languages": [
      {
        "id": "sipi",
        "aliases": ["SiPi", "sipi"],
        "extensions": [".sipi"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sipi",
        "scopeName": "source.sipi",
        "path": "./syntaxes/sipi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sipi",
        "path": "./snippets/sipi.code-snippets"
      }
    ]
  }
}
