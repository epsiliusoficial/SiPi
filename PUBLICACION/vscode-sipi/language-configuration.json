{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(si|mientras|repetir|para_cada|funcion|clase|metodo|interfaz|intentar|crear_juego|escena_3d|ventana)\\b",
      "end": "^\\s*fin\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(si|sino|mientras|repetir|para_cada|funcion|clase|metodo|interfaz|intentar|capturar|crear_juego|escena_3d|ventana|enum|estructura)\\b.*$",
    "decreaseIndentPattern": "^\\s*fin\\b"
  }
}
