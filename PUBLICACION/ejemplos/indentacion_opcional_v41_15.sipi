programa "IndentacionOpcionalV41_15"

// Estilo clasico de SiPi: con 'fin' explicito (sigue funcionando igual)
funcion cuadrado(x)
    devolver x * x
fin

// Estilo nuevo: indentacion consistente, sin 'fin' (como Python)
variable i = 0
mientras i < 3
    llamar_valor cuadrado(i) -> r
    decir "Cuadrado de {i}: {r}"
    sumar i 1

// Los dos estilos se pueden mezclar libremente, incluso anidados
si i == 3
    decir "Termine el bucle"
    si i > 0
        decir "Y el resultado es positivo"
decir "Fin del programa"
