programa "Calculadora simple con ventana real"

variable resultado_texto = "Resultado: 0"

funcion sumar_numeros()
    variable a = entrada_a
    variable b = entrada_b
    variable total = a + b
    decir "Suma calculada: {total}"
fin

ventana "SiPi - Calculadora" 400 250
    etiqueta "Calculadora hecha con SiPi" 90 20
    etiqueta "Numero A:" 40 70
    entrada entrada_a 140 68
    etiqueta "Numero B:" 40 110
    entrada entrada_b 140 108
    boton "Sumar (ver resultado en consola)" 90 160 sumar_numeros()
fin
