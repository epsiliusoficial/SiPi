programa "Agenda de contactos con GUI y base de datos real"

funcion guardar_contacto()
    guardar_dato "contacto_{campo_nombre}" campo_telefono
    decir "Contacto guardado: {campo_nombre} -> {campo_telefono}"
fin

funcion buscar_contacto()
    obtener_dato "contacto_{campo_nombre}" -> telefono_encontrado
    decir "Telefono de {campo_nombre}: {telefono_encontrado}"
fin

ventana "SiPi - Agenda de Contactos" 420 320
    etiqueta "Agenda de contactos (guardado real y persistente)" 20 15
    etiqueta "Nombre:" 20 60
    entrada campo_nombre 110 58
    etiqueta "Telefono:" 20 100
    entrada campo_telefono 110 98
    boton "Guardar contacto" 20 150 guardar_contacto()
    boton "Buscar por nombre" 20 190 buscar_contacto()
    etiqueta "Los datos quedan en sipi_datos.json" 20 260
fin
