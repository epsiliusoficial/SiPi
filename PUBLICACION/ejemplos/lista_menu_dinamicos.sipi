programa "Lista de tareas y selector de pais con datos dinamicos reales"

lista_crear tareas_pendientes
lista_agregar tareas_pendientes "Terminar el informe"
lista_agregar tareas_pendientes "Llamar al cliente"
lista_agregar tareas_pendientes "Revisar el codigo"
lista_agregar tareas_pendientes "Preparar la presentacion"

lista_crear paises_disponibles
lista_agregar paises_disponibles "Argentina"
lista_agregar paises_disponibles "Chile"
lista_agregar paises_disponibles "Uruguay"
lista_agregar paises_disponibles "Mexico"

funcion confirmar_seleccion()
    decir "Tarea seleccionada: {tarea_elegida}"
    decir "Pais seleccionado: {pais_elegido}"
fin

ventana "SiPi - Datos dinamicos reales" 420 400
    etiqueta "Elegi una tarea:" 20 15
    lista 20 40 35 6 tareas_pendientes -> tarea_elegida
    etiqueta "Elegi un pais:" 20 220
    menu_desplegable 20 245 25 paises_disponibles -> pais_elegido
    boton "Confirmar" 20 290 confirmar_seleccion()
fin
