programa "Juego con obstaculos que se mueven solos"

funcion ganar_punto()
    sumar puntaje 1
    decir "Punto! Puntaje: {puntaje}"
fin

funcion chocar_obstaculo()
    decir "Chocaste con el obstaculo movil. Puntaje final: {puntaje}"
fin

crear_juego "SiPi - Obstaculos Moviles" 640 480
    sprite jugador 300 220 40 40 "cian"
    sprite obstaculo1 100 100 30 30 "rojo"
    sprite obstaculo2 500 300 30 30 "amarillo"
    sprite meta 50 400 30 30 "verde"
    velocidad 6
    mover_aleatorio obstaculo1 3
    mover_aleatorio obstaculo2 4
    puntaje_inicial 0
    mostrar_puntaje
    chocar jugador meta ganar_punto()
    chocar jugador obstaculo1 chocar_obstaculo()
    chocar jugador obstaculo2 chocar_obstaculo()
fin
