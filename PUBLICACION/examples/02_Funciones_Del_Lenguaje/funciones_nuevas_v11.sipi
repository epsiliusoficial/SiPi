/*
Este ejemplo muestra las nuevas funciones de SiPi v11:
- Constantes
- Comentarios multilinea (este mismo bloque)
- Cadenas multilinea
- Sugerencias inteligentes de errores
- Pila de llamadas al fallar
*/

programa "Funciones nuevas de SiPi v11"

// Constantes: no se pueden modificar despues de creadas
const VERSION_APP = "1.0"
const MAX_INTENTOS = 3
decir "App version {VERSION_APP}, maximo {MAX_INTENTOS} intentos"

// Cadena multilinea: util para generar HTML, mensajes largos, plantillas, etc.
variable nombre_usuario = "Mateo"
variable plantilla_bienvenida = """
====================================
  Bienvenido, {nombre_usuario}!
  Este texto viene de una cadena
  multilinea real, con varios
  renglones y variables interpoladas.
====================================
"""
decir plantilla_bienvenida

decir "Si intentas modificar una constante, SiPi te lo va a impedir:"
intentar
    variable MAX_INTENTOS = 999
capturar
    decir "Error controlado: {error}"
fin

decir ""
decir "Todo funciono correctamente."
