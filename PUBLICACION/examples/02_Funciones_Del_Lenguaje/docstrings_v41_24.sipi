programa "Calculadora"

funcion sumar(a, b)
    //! Suma dos numeros y devuelve el resultado.
    //! @param a: primer numero
    //! @param b: segundo numero
    //! @returns: a + b
    devolver a + b
fin

funcion restar(a, b)
    devolver a - b
fin

interfaz Sonable
    metodo hacer_sonido()
    fin
fin

clase Perro implementa Sonable
    //! Representa a un perro que puede hacer sonidos.
    nombre = ""

    metodo hacer_sonido()
        //! Devuelve el sonido que hace este perro.
        //! @returns: el texto "Guau!"
        devolver "Guau!"
    fin
fin
