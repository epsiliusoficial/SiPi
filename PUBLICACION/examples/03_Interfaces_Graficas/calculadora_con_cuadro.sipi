programa "Calculadora real con cuadro de color y campos numericos"

funcion calcular_total()
    variable total = precio_unitario * cantidad_items
    decir "Total: ${total}"
fin

ventana "Calculadora de Total" 400 250
    cuadro 20 20 100 40 "azul"
    etiqueta "Precio unitario:" 20 80
    entrada precio_unitario 160 78
    etiqueta "Cantidad:" 20 120
    entrada cantidad_items 160 118
    boton "Calcular total" 20 160 calcular_total()
fin
