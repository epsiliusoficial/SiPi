programa "Lista de productos generada dinamicamente en una ventana"

lista_crear productos
lista_agregar productos "Manzana - $500"
lista_agregar productos "Banana - $300"
lista_agregar productos "Pera - $450"
lista_agregar productos "Naranja - $350"

ventana "Catalogo de Productos" 400 350
    etiqueta "Catalogo del dia" 20 15
    variable y_actual = 60
    para_cada producto en productos
        etiqueta producto 30 y_actual
        sumar y_actual 35
    fin
fin
