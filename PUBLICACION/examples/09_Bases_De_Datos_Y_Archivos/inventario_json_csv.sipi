programa "Inventario con JSON y CSV reales (compatible con Excel)"

diccionario_crear producto
diccionario_asignar producto "nombre" "Teclado mecanico"
diccionario_asignar producto "precio" 45000
diccionario_asignar producto "stock" 12

json_guardar producto "inventario_producto.json"
decir "Producto guardado en un archivo .json real."

json_leer "inventario_producto.json" -> producto_recuperado
diccionario_obtener producto_recuperado "nombre" -> nombre_recuperado
decir "Recuperado desde el archivo JSON: {nombre_recuperado}"

lista_crear ventas_del_dia

diccionario_crear venta1
diccionario_asignar venta1 "producto" "Teclado mecanico"
diccionario_asignar venta1 "cantidad" 2
diccionario_asignar venta1 "total" 90000
lista_agregar ventas_del_dia venta1

diccionario_crear venta2
diccionario_asignar venta2 "producto" "Mouse inalambrico"
diccionario_asignar venta2 "cantidad" 5
diccionario_asignar venta2 "total" 25000
lista_agregar ventas_del_dia venta2

csv_guardar ventas_del_dia "ventas_del_dia.csv"
decir "Ventas guardadas en un archivo .csv real, listo para abrir en Excel."

csv_leer "ventas_del_dia.csv" -> ventas_leidas
para_cada venta en ventas_leidas
    diccionario_obtener venta "producto" -> nombre_producto
    diccionario_obtener venta "total" -> total_venta
    decir "Venta: {nombre_producto} por ${total_venta}"
fin

decir ""
decir "Archivos generados: inventario_producto.json y ventas_del_dia.csv"
