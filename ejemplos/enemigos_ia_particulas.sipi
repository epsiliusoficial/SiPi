programa "Enemigos con IA y particulas reales"

funcion perder_contra_perseguidor()
    explosion jugador_x jugador_y 30
    decir "Te atrapo el perseguidor! Puntaje final: {puntaje}"
fin

funcion ganar_punto()
    explosion jugador_x jugador_y 15
    sumar puntaje 5
    decir "Punto! Puntaje: {puntaje}"
fin

crear_juego "SiPi - Enemigos con IA" 640 480
    sprite jugador 300 220 30 30 "cian"
    sprite perseguidor 50 50 30 30 "rojo"
    sprite guardian 550 400 30 30 "morado"
    sprite patrulla 100 100 25 25 "amarillo"
    sprite meta 320 240 20 20 "verde"

    velocidad 4
    puntaje_inicial 0
    mostrar_puntaje

    ia perseguidor seguir jugador 1.5
    ia guardian escapar jugador 1.2
    ia patrulla patrullar 100 100 500 100 2

    chocar jugador perseguidor perder_contra_perseguidor()
    chocar jugador meta ganar_punto()
fin
